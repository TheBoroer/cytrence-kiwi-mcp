{
  "name": "cytrence-kiwi-mcp",
  "version": "2026.11.0",
  "description": "MCP server that lets AI agents see and control a computer through a Cytrence Kiwi USB-C KVM (HDMI capture + USB keyboard/mouse emulation).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cytrence-kiwi-mcp": "dist/index.js",
    "kiwi": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "serve": "tsx src/index.ts serve",
    "cli": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "serialport": "^13.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
